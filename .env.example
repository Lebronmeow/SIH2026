# =============================================================================
# ORCA — Marine Ecosystem Reasoning with Collaborative Agents (SIH26176)
# Example environment configuration. Copy to .env and adjust.
# NEVER commit a real .env with credentials.
# =============================================================================

# ---------------------------------------------------------------- application
ORCA_DEBUG=true
ORCA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------------------------------------------------------ data mode
# live = fetch from remote providers   |   demo = serve cached data packs
# In demo mode the UI MUST show a "DEMO / CACHED DATA" banner (enforced).
ORCA_DATA_MODE=demo

# Repository-relative paths
ORCA_DATA_DIR=data
ORCA_DEMO_DIR=data/demo
ORCA_CACHE_DIR=data/cache
ORCA_CACHE_TTL_HOURS=6

# ------------------------------------------------------ dataset configuration
# Optional override for the dataset catalog JSON (dataset IDs are config, never
# hardcoded in Python source). Points to a JSON file with ERDDAP/marine dataset
# mappings. See backend/app/config/datasets.json for the default.
# ORCA_DATASETS_CONFIG=/absolute/path/to/datasets.json

# ------------------------------------------------------------ database (SQL)
# Default dev DB is SQLite (no server needed). For PostGIS use e.g.:
#   postgresql+psycopg://orca:orca@localhost:5432/orca
ORCA_DATABASE_URL=sqlite:///./orca.db

# ------------------------------------------------------------------ LLM agent
# ORCA runs a deterministic pipeline with NO LLM by default.
# Set provider to enable the reasoning/orchestration layer.
# none | openai | azure | anthropic | openai-compatible
ORCA_LLM_PROVIDER=none
# ORCA_LLM_MODEL=gpt-4o-mini
# ORCA_LLM_API_KEY=
# ORCA_LLM_BASE_URL=            # for openai-compatible local/3rd-party endpoints
ORCA_LLM_TIMEOUT_SECONDS=45

# ---------------------------------------------- Bhashini (voice / translate)
# Leave blank to run English-text-only with speech services disabled.
# Register at https://bhashini.gov.in to obtain credentials.
ORCA_BHASHINI_ENABLED=false
ORCA_BHASHINI_API_KEY=
ORCA_BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/pipeline/v2/run

# ------------------------------------------------------- provider switches
# ERDDAP server list is configured in backend/app/config/erddap_servers.json
# Protected Planet (WDPA) — free key via https://api.protectedplanet.net
ORCA_PROTECTED_PLANET_API_KEY=
